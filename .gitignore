# macOS
.DS_Store
.AppleDouble
.LSOverride

# editors
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace

# python (if any helper scripts adopt python)
__pycache__/
*.py[cod]
.venv/
venv/
.python-version

# node (if any skill uses JS tooling)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# secrets / local env
.env
.env.local
.env.*.local

# logs
*.log
logs/

# graphify output (if anyone runs graphify inside gru by mistake — it shouldn't, but defensively)
graphify-out/

# scratch / throwaway
scratch/
.tmp/
tmp/

# write-a-prd / future-skill drafts (per-skill, gitignored, .gitkeep preserved)
.agents/skills/*/drafts/*
!.agents/skills/*/drafts/.gitkeep

# prd-to-jira-issues / future-skill redlines (per-skill, gitignored, .gitkeep preserved)
.agents/skills/*/redlines/*
!.agents/skills/*/redlines/.gitkeep

# python build / install artifacts inside skill scripts and shared lib
.agents/skills/*/scripts/*.egg-info/
.agents/skills/*/scripts/.pytest_cache/
.agents/skills/*/scripts/.ruff_cache/
.agents/skills/*/scripts/.venv/
.agents/skills/*/scripts/uv.lock
.agents/skills/_lib/__pycache__/
.agents/skills/_lib/.pytest_cache/
.agents/skills/_lib/.ruff_cache/
.agents/skills/_lib/.venv/
.agents/skills/_lib/uv.lock
.agents/skills/_lib/tests/__pycache__/
